newline='') as accounts:
...:
print(f'{"Account":<10}{"Name":<10}
{"Balance":>10}')
...:
reader = csv.reader(accounts)
...:
for record in reader:
...:
account, name, balance = record
...:
print(f'{account:<10}{name:<10}
{balance:>10}')
